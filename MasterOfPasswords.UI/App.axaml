<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MasterOfPasswords.UI.App"
             RequestedThemeVariant="Default">
    <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.Styles>
        <FluentTheme />  <!-- Устанавливаем Fluent стиль для приложения -->

        <!-- Можно добавить дополнительные стили или темы, если потребуется -->
        <!-- <StyleInclude Source="resm:MasterOfPasswords.UI.Styles?assembly=MasterOfPasswords.UI" /> -->
    </Application.Styles>

    <Application.DataTemplates>
        <!-- Здесь можно определить собственные шаблоны данных, если это необходимо -->
    </Application.DataTemplates>
</Application>