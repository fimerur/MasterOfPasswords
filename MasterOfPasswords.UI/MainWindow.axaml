<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewModels="clr-namespace:MasterOfPasswords.UI.ViewModels"
        x:Class="MasterOfPasswords.UI.MainWindow"
        Title="Password Manager" Width="400" Height="300"
        x:DataType="viewModels:MainViewModel">
    <StackPanel Margin="20">
        <TextBlock Text="Login" />
        <TextBox Text="{Binding Login}" Width="300" Margin="0,5" />

        <TextBlock Text="Password" />
        <!-- Изменено на TextBox для ввода пароля -->
        <TextBox Text="{Binding Password}" Width="300" Margin="0,10" />

        <Button Content="Add Password" Command="{Binding AddPasswordCommand}" Width="300" Margin="0,10" />
        <Button Content="Get Password" Command="{Binding GetPasswordCommand}" Width="300" Margin="0,10" />
        <Button Content="Update Password" Command="{Binding UpdatePasswordCommand}" Width="300" Margin="0,10" />
        
    </StackPanel>
</Window>